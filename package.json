{
  "name": "payminto-clearing",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "demo": "node apps/node/scripts/check-runtime.mjs && pnpm --filter @payminto/demo demo",
    "demo:stage": "node apps/node/scripts/check-runtime.mjs && pnpm --filter @payminto/demo demo:stage",
    "local": "node apps/node/scripts/check-runtime.mjs && pnpm --silent --filter @payminto/local local",
    "live:capture": "node apps/node/scripts/check-runtime.mjs && pnpm --silent --filter @payminto/local capture",
    "verify:near": "node apps/node/scripts/check-runtime.mjs && pnpm --silent --filter @payminto/demo verify:near",
    "mcp": "node apps/node/scripts/check-runtime.mjs && pnpm --filter @payminto/mcp start",
    "market": "pnpm --silent --filter @payminto/agent-market market",
    "agent": "node apps/node/scripts/check-runtime.mjs && node apps/agent/src/cli.ts",
    "swarm": "node apps/node/scripts/check-runtime.mjs && node apps/swarm/src/cli.ts",
    "node": "pnpm --filter @payminto/node start",
    "backup": "pnpm --filter @payminto/node backup"
  },
  "pnpm": {
    "overrides": {
      "minimatch@>=7.0.0 <11.0.1": "11.0.4"
    }
  }
}
