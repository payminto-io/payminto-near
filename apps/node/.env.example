# Payminto Clearing Node configuration. Copy to .env (git-ignored) and fill in.
# Every value is validated at startup; errors name the variable, never its value.

# HTTP
PORT=8787
# Loopback by default; put a TLS reverse proxy in front (docs/OPERATIONS.md). The Docker image binds 0.0.0.0.
HOST=127.0.0.1
PUBLIC_URL=http://localhost:8787
# Comma-separated origins allowed by CORS (the dashboard). Use * only for local experiments.
CORS_ORIGINS=http://localhost:3000

# NEAR: near:sandbox (local, default) or near:testnet. There is no mainnet node mode.
NETWORK=near:sandbox
# Defaults to the network's public RPC.
# RPC_URL=
# The hub contract and the account that settles. Budgets name OPERATOR_ACCOUNT as their settler.
HUB_ACCOUNT=hub.sandbox
OPERATOR_ACCOUNT=node.sandbox
# Optional: defaults to Circle testnet USDC on near:testnet.
# TOKEN_ACCOUNT=
# Function-call key limited to settle_batch and payout on the hub. Keep the account's full-access key offline.
OPERATOR_KEY=ed25519:replace-me
# Seed of the key that signs per-call receipts and checkout terms (not a NEAR account key). This value is public and
# refused on near:testnet: generate one with openssl rand -hex 32.
NODE_SIGNING_SEED=1111111111111111111111111111111111111111111111111111111111111111

# Bearer token for admin routes, /metrics and the dashboard (12+ characters; 32+ and not dev-admin-token on near:testnet).
# Generate one with: openssl rand -hex 32
ADMIN_TOKEN=dev-admin-token

# Storage (SQLite, WAL). Tests never use this path.
DB_PATH=./data/clearing.db

# Settlement: 0 = manual only (POST /v1/settlements).
SETTLE_INTERVAL_SEC=0
SETTLE_MIN_CALLS=1
FUNDS_REFRESH_SEC=30
# Oldest hub snapshot (escrow, credit, revoked or not) a call may be decided on, in milliseconds. An older one is read
# again first, and if the hub cannot be read the call is refused with NET_EXPOSURE and a short retry. 500 to 60000.
FUNDS_MAX_AGE_MS=10000
# Payees new to a Budget: the first settlement of each (Budget, payee) pair makes the settler pay permanent hub storage.
# The least first payment to a new payee, in atomic token units (1000 = 0.001 USDC), and how many new payees one Budget
# may pay per rolling hour. 0 disables either.
NEW_PAYEE_MIN_AMOUNT=1000
NEW_PAYEES_PER_HOUR=20
# Pays out hub credit to batch creditors and checkout merchants this often, at most 10 accounts per payout call
# (0 = only on POST /v1/payouts).
PAYOUT_INTERVAL_SEC=300

# Rate limits (token buckets: requests per second and burst; 0 rps disables). Answers 429 with Retry-After.
# Per provider API key on POST /v1/vouchers:
RATE_LIMIT_PROVIDER_RPS=200
RATE_LIMIT_PROVIDER_BURST=1000
# Per client IP on every request without the admin token (public reads, cosign, signed revokes, failed auth):
RATE_LIMIT_IP_RPS=100
RATE_LIMIT_IP_BURST=1000
# Vouchers not signed by their Budget's agent key (per provider key, and per client IP on the public pay routes).
# They get a plain error and are never recorded as refusals; past this bucket the answer is 429.
RATE_LIMIT_UNSIGNED_RPS=5
RATE_LIMIT_UNSIGNED_BURST=50
# Reverse proxies in front of the node whose X-Forwarded-For you trust (1 behind Caddy or nginx). 0 = socket address.
TRUST_PROXY_HOPS=0

# Growth bounds: identical denials within DENIAL_DEDUP_SEC fold into one row; oldest rows past the caps are pruned.
DENIAL_DEDUP_SEC=60
DENIALS_MAX_ROWS=100000
EVENTS_MAX_ROWS=200000

# Backups (pnpm --filter @payminto/node backup) are written here.
# BACKUP_DIR=./backups

LOG_LEVEL=info

# The payee check: judges every payee as allow, warn or block before a Budget pays it (apps/node/README.md).
# on (default) or off. It reads accounts through RPC_URL and signs nothing.
PAYEE_CHECK=on
# Where account ages come from: nearblocks (default on near:testnet) or off (default on near:sandbox, which has no
# indexer). The account ids that are checked are sent to that indexer.
# PAYEE_CHECK_INDEXER=nearblocks
# Optional NearBlocks API key; the keyless tier is rate limited.
# PAYEE_CHECK_INDEXER_KEY=

# Payminto Gateway: hosted checkout paid from NEAR wallets, agent payments by voucher. Off unless GATEWAY_PAYOUT_ACCOUNT
# or GATEWAY_ENABLED=true. The hub must hold this node's checkout key (set_checkout_key with the NODE_SIGNING_SEED key).
# GATEWAY_PAYOUT_ACCOUNT=shop.testnet
# GATEWAY_ENABLED=false
# PLATFORM_NAME=Payminto
# PLATFORM_FEE_ACCOUNT=                 # the operator take rate is roadmap; fees stay zero
# PUBLIC_CHECKOUT_URL=http://localhost:3000
# CHECKOUT_TTL_SECONDS=1800
# WEBHOOK_ALLOW_PRIVATE=true            # default true on near:sandbox only; refused on near:testnet
# GATEWAY_WATCH_INTERVAL_MS=2000

# Merchant AI agents (docs/AGENTS.md, docs/OPERATIONS.md section 8). On by default locally with the gateway; off on
# near:testnet unless AGENTS_ENABLED=true, which then needs a real AGENT_SECRETS_KEY (openssl rand -base64 32).
# AGENTS_ENABLED=true
# AGENT_SECRETS_KEY=                    # base64, 32 bytes; unset locally = the documented dev key
# AGENT_SECRETS_KEY_VERSION=1
# AGENT_SECRETS_KEY_PREVIOUS=           # the old key during a rotation (version AGENT_SECRETS_KEY_VERSION - 1)
# AGENT_ALLOW_PRIVATE_MODEL_URLS=false  # true lets OpenAI-compatible base URLs reach Ollama or vLLM on private addresses
# AGENT_WORKERS=2                       # runs at once in this node (0 = no worker here)
# AGENT_MAX_PER_MERCHANT=1              # runs at once per business
# AGENT_POLL_MS=1000
