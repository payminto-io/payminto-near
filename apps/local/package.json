{
  "name": "@payminto/local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "pnpm local: the whole Payminto product on a local near-sandbox node, with the dashboard and a local signer in place of a browser wallet",
  "scripts": {
    "local": "node src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@payminto/chain": "workspace:*",
    "@payminto/demo": "workspace:*",
    "@payminto/near-addons": "workspace:*",
    "@payminto/node": "workspace:*",
    "@payminto/protocol": "workspace:*",
    "@payminto/relayer": "workspace:*",
    "@payminto/sdk": "workspace:*",
    "hono": "^4.13.13",
    "near-kit": "0.20.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
