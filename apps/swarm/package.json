{
  "name": "@payminto/swarm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A group-buying swarm on Payminto: buyer agents pool demand for GPU hours, sellers bid sealed, the winner is paid per delivered unit by signed vouchers, and the clearing node nets and settles",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "swarm": "node src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@payminto/chain": "workspace:*",
    "@payminto/demo": "workspace:*",
    "@payminto/node": "workspace:*",
    "@payminto/protocol": "workspace:*",
    "@payminto/sdk": "workspace:*",
    "hono": "^4.13.13",
    "near-kit": "0.20.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
