# Payminto Relayer configuration. Copy to .env (git-ignored) and fill in.
# Every value is validated at startup; errors name the variable and say what to put there, and never print a secret.

# --- Required ---

# The account that signs the outer transaction and pays the gas. Use a dedicated account that does nothing else.
RELAYER_ACCOUNT=relayer.example.testnet
# That account's full-access secret key (the private_key field of its NEAR credentials file).
# Keep it only here. A function-call key cannot sign the transaction that carries a delegate.
RELAYER_KEY=ed25519:replace-me
# The Payminto hub. It is the only contract this relayer pays for.
HUB_ACCOUNT=hub.example.testnet

# --- Network ---

# near:sandbox (local, default) or near:testnet. Mainnet is refused.
NETWORK=near:testnet
# Defaults to https://rpc.testnet.near.org on near:testnet and http://127.0.0.1:3030 on near:sandbox.
# RPC_URL=

# --- HTTP ---

PORT=8790
# Loopback by default; put a TLS reverse proxy in front. A container sets 0.0.0.0.
HOST=127.0.0.1
# Comma-separated origins allowed by CORS (the dashboard). Use * only for local experiments.
CORS_ORIGINS=http://localhost:3000
# Reverse proxies in front of the relayer whose X-Forwarded-For you trust (1 behind Caddy or nginx). 0 = socket address.
TRUST_PROXY_HOPS=0
# Largest request body in bytes. A signed delegate for one hub call is a few hundred bytes.
MAX_BODY_BYTES=16384

# --- What is sponsored ---

# Comma-separated hub methods the relayer pays for. Unset uses the default list: revoke_budget,reclaim,payout.
# Only add methods that take no deposit and that any caller may safely invoke.
# ALLOWED_METHODS=revoke_budget,reclaim,payout
# Most gas one delegate may attach, summed over its calls (300 is the protocol maximum for one transaction).
MAX_GAS_TGAS=300
# A delegate may stay valid at most this many blocks past the current height, and must have more than
# EXPIRY_MARGIN_BLOCKS left, or it would expire before it lands.
MAX_TTL_BLOCKS=600
EXPIRY_MARGIN_BLOCKS=5

# --- Abuse limits ---

# The cap on what the relayer can be made to spend: gas attached per UTC day, across all senders.
# Each relay counts the gas it attaches plus 5 Tgas for fees. 3000 Tgas is about 0.3 NEAR at the minimum gas price.
DAILY_GAS_BUDGET_TGAS=3000
# Keeps the daily count across restarts. Without it the count starts from zero whenever the process restarts.
GAS_LEDGER_PATH=./data/relayer-gas.json
# Token buckets, requests per minute and burst. 0 per minute disables that limiter. Answers 429 with Retry-After.
# Per client address, on POST /relay:
RATE_LIMIT_IP_PER_MIN=30
RATE_LIMIT_IP_BURST=30
# Per sender account, counted only for delegates signed by a key that is on that account:
RATE_LIMIT_SENDER_PER_MIN=6
RATE_LIMIT_SENDER_BURST=6
# Relays signed and waiting for the network at once; more are answered 429.
MAX_PENDING_RELAYS=16

# --- Operations ---

# The relayer warns at startup and in /health when its balance is below this many NEAR.
LOW_BALANCE_NEAR=0.5
LOG_LEVEL=info
# Deadline for one chain read, and for signing, sending and reaching final execution of one relay.
READ_TIMEOUT_MS=15000
SEND_TIMEOUT_MS=60000
