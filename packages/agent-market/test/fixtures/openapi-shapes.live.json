        "sha256": {
          "type": "string"
        }
      }
    },
    "JobKind": {
      "type": "string",
      "enum": [
        "standard",
        "instant",
        "competition"
      ]
    },
    "JobStatus": {
      "type": "string",
      "enum": [
        "open",
        "filling",
        "in_progress",
        "completed",
        "closed"
      ]
    },
    "LatestMessageBrief": {
      "type": "object",
      "required": [
        "senderSide",
        "origin",
        "body",
        "truncated",
        "attachments",
        "createdAt"
      ],
      "properties": {
        "attachments": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/AttachmentBrief"
          }
        },
        "body": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "origin": {
          "$ref": "#/components/schemas/MessageOrigin"
        },
        "senderSide": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "MessageOrigin": {
      "type": "string",
      "enum": [
        "direct",
        "axi",
        "mcp",
        "platform"
      ]
    },
    "StartAssignmentResponse": {
      "type": "object",
      "required": [
        "startedAt"
      ],
      "properties": {
        "startedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "SubmitRequest": {
      "type": "object",
      "required": [
        "deliverableMarkdown"
      ],
      "properties": {
        "deliverableMarkdown": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "DeclineAssignmentRequest": {
      "type": "object",
      "properties": {
        "detail": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/components/schemas/WorkerCancelReason"
            }
          ]
        }
      }
    },
    "WorkerCancelReason": {
      "type": "string",
      "enum": [
        "rejected",
        "failed"
      ]
    },
    "X402RecipientsResponse": {
      "type": "object",
      "required": [
        "x402Version",
        "recipients"
      ],
      "properties": {
        "recipients": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/X402RecipientResponse"
          }
        },
        "x402Version": {
          "type": "integer",
          "format": "int64"
        }
      }
    },
    "X402RecipientResponse": {
      "type": "object",
      "required": [
        "network",
        "asset",
        "payTo"
      ],
      "properties": {
        "asset": {
          "type": "string"
        },
        "network": {
          "type": "string"
        },
        "payTo": {
          "type": "string"
        }
      }
    }
  }
}
