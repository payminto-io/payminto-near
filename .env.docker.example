# docker compose settings for a Clearing Node on NEAR testnet. Copy to .env (git-ignored) next to docker-compose.yml.
# Every node variable is documented in apps/node/.env.example; anything set here reaches the node container.

NETWORK=near:testnet
RPC_URL=https://rpc.testnet.near.org
# The hub contract and the account that settles (Budgets name it as settler).
HUB_ACCOUNT=
OPERATOR_ACCOUNT=
# Function-call key limited to settle_batch and payout on the hub. Keep the full-access key offline.
OPERATOR_KEY=
# 32 random bytes as 64 lowercase hex characters, for receipt and checkout signing: openssl rand -hex 32
NODE_SIGNING_SEED=
# 32+ random characters: openssl rand -hex 32
ADMIN_TOKEN=

# Public URLs (behind your TLS reverse proxy, docs/OPERATIONS.md)
PUBLIC_URL=https://node.example.com
CORS_ORIGINS=https://dashboard.example.com
# Baked into the dashboard image at build time: the node URL as the operator's browser sees it.
NEXT_PUBLIC_NODE_URL=https://node.example.com
# One reverse proxy in front of the node: trust one X-Forwarded-For hop for per-IP rate limits.
TRUST_PROXY_HOPS=1

# Host bindings (loopback by default; the reverse proxy runs on the same host).
# NODE_PUBLISH=127.0.0.1:8787
# DASHBOARD_PUBLISH=127.0.0.1:3000

SETTLE_INTERVAL_SEC=300
SETTLE_MIN_CALLS=1
LOG_LEVEL=info

# Payminto Gateway (payments, payment links, the hosted checkout). Off unless one of these is set.
# GATEWAY_ENABLED=true
# GATEWAY_PAYOUT_ACCOUNT=                # seeds the first business's payout account (a NEAR testnet account)
# GATEWAY_WATCH_INTERVAL_MS=2000
# The dashboard origin that serves the checkout: a public https origin on testnet.
# PUBLIC_CHECKOUT_URL=https://dashboard.example.com

# Any-chain checkout through NEAR Intents (docs/SELF_HOST.md, "Any-chain checkout (NEAR Intents) in production").
# live is REAL MONEY on NEAR mainnet: the node then offers only payments from other chains and applies the production
# checks (ADMIN_TOKEN, PASSWORD_HASH_COST, https PUBLIC_CHECKOUT_URL, no private webhooks). Runbook: docs/OPERATIONS.md 15.
# INTENTS_CHECKOUT=off                   # off | simulated | live
# ONECLICK_API_KEY=                      # your 1Click partner key; without it buyers pay 0.25% more (the node warns)
# NEAR_MAINNET_RPC_URL=                  # an https NEAR mainnet RPC you trust; the public default is rate limited
# INTENTS_DELIVERY_SENDERS=              # only for an RPC that tracks some shards: 1Click's signer accounts, comma separated
# INTENTS_ORIGINS=                       # 1Click asset ids buyers may pay with; default every supported origin
# INTENTS_SLIPPAGE_STABLE_BPS=10
# INTENTS_SLIPPAGE_VOLATILE_BPS=100
# INTENTS_REFERRAL=payminto
